                      <CellContents>
                        <Textbox Name="Textbox73">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Artificial Intelligence आधारित Proctored परीक्षा पध्दती मध्ये संगणकीय प्रणालीव्दारे परीक्षा व परीक्षार्थींच्या क्रियाकलापांवर पर्यवेक्षण (supervision) ठेवण्यात येते. भ्रमणध्वनी/ संगणक/ लॅपटॉप/ टॅब यांव्दारे घेण्यात येणाऱ्या परीक्षांमध्ये कॅमेरा, मायक्रोफोन व स्क्रीन शेअरिंगव्दारे दूरस्थ पध्दतीने पर्यवेक्षण केले जाते. तसेच, परीक्षांमध्ये काही गैरप्रकार आढळल्यास संगणकीय प्रणालीव्दारे व्हिडिओ व ऑडिओ रेकॉर्डिंग होत असते.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontFamily>Nirmala UI</FontFamily>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
