                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>तथापि, आपण उपरोक्त नमुद परीक्षेमध्ये परीक्षा नियमांचे भंग केल्याचे उपलब्ध व्हिडिओ व ऑडिओ रेकॉर्डिंगवरुन स्पष्ट निदर्शनास आले आहे. मंडळाच्या परीक्षा नियमावलीतील नियम क्र.२८ अन्वये परीक्षेत केलेल्या गैरप्रकारामुळे निकाल रद्द करुन पुढिल १ ते ५ परीक्षांकरिता प्रतिबंध (debar) करण्याची तरतुद आहे.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontFamily>Nirmala UI</FontFamily>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
