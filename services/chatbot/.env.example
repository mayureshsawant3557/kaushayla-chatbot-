# MSBSVET KAUSHALYA AI - FASTAPI CHATBOT CONFIGURATION TEMPLATE
# Copy to services/chatbot/.env and supply your credentials.

# Google Gemini API Key (Required for Hosted LLM Completions)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# Somya IndicTTS Neural Voice Service URL
# Local dev: http://127.0.0.1:8006/synthesize
# Dedicated remote GPU host: http://<gpu-host-ip>:8006/synthesize
SOMYA_TTS_URL=http://127.0.0.1:8006/synthesize

# Remote TTS Bearer Authentication Token (optional)
SOMYA_TTS_API_KEY=

# Somya TTS Request Timeout in seconds
SOMYA_TTS_TIMEOUT=45.0

# Service Port and Environment
PORT=8005
NODE_ENV=development
