# SOMYA INDIC-TTS NEURAL SERVICE CONFIGURATION TEMPLATE
# Copy to services/tts/.env (optional)

# Custom path to llama-server binary (optional - auto-discovered if installed via winget)
LLAMA_SERVER_PATH=

# Custom path to Somya GGUF model file (optional - auto-discovered in huggingface cache)
SOMYA_GGUF_PATH=

# Pre-shared API key for incoming requests (optional - leave empty to disable auth)
TTS_API_KEY=

# Server Port
PORT=8006
