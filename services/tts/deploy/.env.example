# Dedicated Somya IndicTTS GPU Host Configuration
# Place at /opt/msbsvet-tts/.env on the GPU compute host

# Host Network Binding
TTS_PORT=8006
TTS_HOST=0.0.0.0

# Security: Pre-Shared Internal API Key for Main Server to TTS Host Auth
# If empty, authentication is disabled (local dev mode). In production, set to a strong 32+ char token.
SOMYA_TTS_API_KEY=replace_with_strong_internal_auth_token_32chars

# Paths to Binaries and Models
# On Linux:
LLAMA_SERVER_PATH=/opt/msbsvet-tts/bin/llama-server
SOMYA_GGUF_PATH=/opt/msbsvet-tts/models/Somya-IndicTTS.Q4_K_M.gguf
# On Windows:
# LLAMA_SERVER_PATH=C:\msbsvet-tts\bin\llama-server.exe
# SOMYA_GGUF_PATH=C:\msbsvet-tts\models\Somya-IndicTTS.Q4_K_M.gguf

# Internal llama-server Port
SOMYA_PORT=8008

# Hardware Acceleration: Vulkan0 or CUDA (leave empty for auto-detect)
# Offload 99 layers into GPU VRAM (requires ~2.5 GB VRAM)
LLAMA_NGL=99
LLAMA_THREADS=8

